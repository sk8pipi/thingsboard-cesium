COMPOSE_PROJECT_NAME=tb-video-validation

MYSQL_DATABASE=wvp
MYSQL_USER=wvp_user
MYSQL_PASSWORD=replace-with-a-local-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
REDIS_PASSWORD=replace-with-a-local-redis-password

ZLM_HTTP_PORT=18081
ZLM_PUBLIC_HTTP_PORT=80
ZLM_RTMP_PORT=10001
ZLM_RTSP_PORT=10002
ZLM_RTP_PORT=10003
ZLM_RTC_PORT=8000

# Local validation uses localhost. Set this to the server reachable IP in deployment.
WVP_STREAM_IP=127.0.0.1
